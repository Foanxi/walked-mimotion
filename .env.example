# 复制后填写：cp .env.example .env
# .env 已加入 .gitignore，请勿提交到仓库

# ---------- 账号配置（二选一） ----------
# 方式一：CONFIG，单行 JSON（推荐，多账号用 # 分隔）
CONFIG={"USER":"abc@xx.com","PWD":"password","MIN_STEP":"18000","MAX_STEP":"25000","SLEEP_GAP":"5"}
# 方式二：不填 CONFIG 时使用下面两项
# USER=13800138000
# PWD=password

# ---------- 登录态加密 ----------
# 必须 16 位字符，用于加密保存登录态 encrypted_tokens.data，请勿泄露
AES_KEY=1234567890abcdef

# ---------- 页面访问口令 ----------
# 公网部署必填；留空则页面不做登录校验（仅建议内网/本地使用）
WEB_PASSWORD=

# ---------- 服务端口 ----------
# 源码直跑 / systemd 部署时生效（Docker 部署以 docker-compose.yml 的端口映射为准）
PORT=8888

# ---------- 数据目录（可选） ----------
# 指定后 .env 与 encrypted_tokens.data 都读写该目录，systemd 部署脚本会自动设置为安装目录
# DATA_DIR=/opt/mimotion
